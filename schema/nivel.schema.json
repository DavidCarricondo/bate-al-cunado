{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nivel de Bate al cuñado",
  "type": "object",
  "required": ["id", "orden", "titulo", "preguntas"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "orden": { "type": "integer", "minimum": 1 },
    "titulo": { "type": "string" },
    "cunao": {
      "type": "object",
      "description": "Imágenes del cuñado para este nivel. Si falta, se usa el dibujo por defecto.",
      "required": ["normal", "acierto", "fallo"],
      "properties": {
        "normal": { "type": "string", "description": "Imagen por defecto, mientras suelta el bulo" },
        "acierto": { "type": "string", "description": "Imagen cuando el jugador acierta (el cuñado pierde)" },
        "fallo": { "type": "string", "description": "Imagen cuando el jugador falla (el cuñado gana)" }
      }
    },
    "vidas": {
      "type": "object",
      "description": "Cómo se dibuja la paciencia del jugador. Si falta, son copas de vino.",
      "required": ["icono", "nombre"],
      "properties": {
        "icono": { "type": "string", "description": "Emoji de cada vida, p. ej. 🍷" },
        "nombre": { "type": "string", "description": "Nombre en plural para lectores de pantalla, p. ej. copas" }
      },
      "additionalProperties": false
    },
    "medallas": {
      "type": "object",
      "description": "Preguntas dominadas (acertadas en partidas ganadas) necesarias para cada medalla. Si falta oro, son todas las del nivel.",
      "properties": {
        "bronce": { "type": "integer", "minimum": 1 },
        "plata": { "type": "integer", "minimum": 1 },
        "oro": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "finales": {
      "type": "object",
      "description": "Textos de la pantalla final propios del nivel. Lo que falte usa los textos de bar por defecto de index.html.",
      "properties": {
        "sin_paciencia": { "$ref": "#/$defs/final" },
        "fuera_de_combate": { "$ref": "#/$defs/final" },
        "empate": { "$ref": "#/$defs/final" },
        "gana_cunao": { "$ref": "#/$defs/final" }
      }
    },
    "reacciones": {
      "type": "object",
      "properties": {
        "acierto": { "type": "array", "items": { "type": "string" }, "description": "Lo que dice el cuñado cuando le desmontas" },
        "fallo": { "type": "array", "items": { "type": "string" }, "description": "Lo que dice el cuñado cuando gana" }
      }
    },
    "preguntas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mito", "falacia", "opciones", "explicacion", "fuente"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "mito": { "type": "string", "description": "Frase del cuñado" },
          "falacia": { "type": "string", "description": "Nombre corto del truco lógico" },
          "opciones": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "contains": { "type": "object", "properties": { "correcta": { "const": true } } },
            "minContains": 1,
            "maxContains": 1,
            "items": {
              "type": "object",
              "required": ["texto", "correcta"],
              "properties": {
                "texto": { "type": "string", "description": "Réplica corta, del mismo tono y longitud que las demás" },
                "correcta": { "type": "boolean" },
                "por_que": { "type": "string", "description": "Obligatorio en las incorrectas: por qué no sirve" }
              },
              "if": { "properties": { "correcta": { "const": false } } },
              "then": { "required": ["por_que"] }
            }
          },
          "explicacion": { "type": "string", "description": "Desarrollo con los datos, se muestra tras responder" },
          "fuente": { "$ref": "#/$defs/fuente", "description": "Fuente principal, preferiblemente revisada por pares (DOI)" },
          "fuentes_adicionales": {
            "type": "array",
            "description": "Opcional: fuentes de apoyo que no son artículos científicos (informes, organismos, divulgación)",
            "items": { "$ref": "#/$defs/fuente" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "final": {
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "texto": { "type": "string" },
        "frase": { "type": "string", "description": "Lo que dice el cuñado en el bocadillo" }
      }
    },
    "fuente": {
      "type": "object",
      "required": ["texto", "url"],
      "properties": { "texto": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    }
  }
}
